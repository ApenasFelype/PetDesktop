<Window x:Class="PetDesktop.source.UI_status.PetStatus"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PetDesktop.source.UI_status"
        mc:Ignorable="d"
        Title="Status" Height="250" Width="300"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="15">

        <TextBlock Text="Meu Pet"
                   FontSize="20"
                   HorizontalAlignment="Center"/>

        <TextBlock Text="Fome"/>
        <ProgressBar x:Name="HungerBar"
                     Height="20"
                     Maximum="100"/>

        <TextBlock Text="Sede"/>
        <ProgressBar x:Name="ThirstBar"
                     Height="20"
                     Maximum="100"/>

        <TextBlock Text="Sono"/>
        <ProgressBar x:Name="SleepBar"
                     Height="20"
                     Maximum="100"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0">

            <Button Content="Alimentar"
                    Click="FeedClick"
                    Margin="3"/>

            <Button Content="Água"
                    Click="WaterClick"
                    Margin="3"/>

            <Button Content="Dormir"
                    Click="SleepClick"
                    Margin="3"/>

        </StackPanel>

    </StackPanel>

</Window>
